					"transformations": [
						{
							"name": "derivedColumnHash"
						},
						{
							"name": "derivedColumnDBHash"
						},
						{
							"name": "existsHc"
						},
						{
							"name": "SrcderivedActiveCol"
						},
						{
							"name": "selectinsert"
						},
						{
